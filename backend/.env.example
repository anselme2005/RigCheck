
# Application environment
NODE_ENV=development
PORT=5000

# Browser origins permitted to call the API.
# Add other trusted development origins here only when needed.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
# Supply your own local MongoDB URL or MongoDB Atlas connection string
# in the private .env file, never in this example file.
MONGODB_URI=

# API configuration
API_VERSION=v1

# Request rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100